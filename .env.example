# Copy this file to `.env.local` and fill in. On Vercel, set these as
# Environment Variables in the project settings.

# Turso (libSQL) database — https://turso.tech
# Create a DB, then: `turso db show <name> --url` and `turso db tokens create <name>`
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Secret used to sign login session cookies. Use a long random string.
# Generate one with:  openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# Login users. JSON array of { username, password, name }.
# These accounts are created/updated on every app start, so editing this line
# is enough to add a person or reset a password. Keep this value private.
PAISA_SEED_USERS=[{"username":"admin","password":"changeme","name":"Admin"}]

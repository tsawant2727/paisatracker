# Copy this file to `.env.local` and adjust.

# SQLite database file (Next.js app)
DATABASE_PATH=./data/paisa.db

# Same path for `drizzle-kit` (npm run db:studio / push)
DATABASE_URL=./data/paisa.db

# Secret used to sign login session cookies. Use a long random string.
# Generate one with:  openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# Login users. JSON array of { username, password, name }.
# These accounts are created/updated on every app start, so editing this line
# is enough to add a person or reset a password. Keep this file private.
PAISA_SEED_USERS=[{"username":"admin","password":"changeme","name":"Admin"}]
